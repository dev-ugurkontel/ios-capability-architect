{
  "name": "@fillbyte/ios-capability-architect",
  "version": "0.4.0",
  "type": "module",
  "description": "Read-only MCP and CLI tools for evidence-backed Apple capability planning and project configuration auditing.",
  "license": "MIT",
  "author": "Fillbyte",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fillbyte/ios-capability-architect.git",
    "directory": "plugins/ios-capability-architect"
  },
  "homepage": "https://github.com/fillbyte/ios-capability-architect/tree/main/plugins/ios-capability-architect#readme",
  "bugs": {
    "url": "https://github.com/fillbyte/ios-capability-architect/issues"
  },
  "keywords": [
    "apple",
    "codex",
    "ios",
    "mcp",
    "plugin",
    "swift",
    "swiftui"
  ],
  "sideEffects": false,
  "bin": {
    "ios-capability-architect": "bundle/cli.mjs",
    "ios-capability-architect-mcp": "bundle/server.mjs"
  },
  "exports": {
    ".": "./bundle/server.mjs",
    "./cli": "./bundle/cli.mjs"
  },
  "files": [
    ".codex-plugin",
    ".mcp.json",
    "bundle",
    "data/capabilities.json",
    "data/taxonomy.json",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "main": "bundle/server.mjs",
  "scripts": {
    "build": "npm run typecheck && node scripts/build-bundle.mjs && npm run build:skills",
    "build:skills": "node scripts/build-skills-package.mjs",
    "check": "npm run typecheck",
    "start": "node bundle/server.mjs",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "smoke:skills": "node scripts/validate-skills-package.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "validate:plugin": "tsx scripts/validate-plugin-layout.ts",
    "validate:registry": "tsx scripts/validate-registry.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:docs": "tsx scripts/verify-doc-links.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
