{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "ios-capability-architect",
      "include-component-in-tag": false,
      "extra-files": [
        "plugins/ios-capability-architect/package.json",
        {
          "type": "json",
          "path": "plugins/ios-capability-architect/.codex-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$['packages']['plugins/ios-capability-architect']['version']"
        },
        {
          "type": "generic",
          "path": "README.md"
        }
      ]
    }
  }
}
